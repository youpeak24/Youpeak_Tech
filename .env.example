# AI chat assistant (server-only, used by api/chat.js).
# Locally: copy this file to .env. On Vercel: add the variable under Project Settings > Environment Variables, then redeploy.
# Get a key at https://console.groq.com/keys. Never prefix it with VITE_.
GROQ_API_KEY=
# Optional: override the primary model (default openai/gpt-oss-120b, with automatic fallbacks).
GROQ_MODEL=
